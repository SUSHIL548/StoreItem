<% layout("/layouts/boilerplate") %>
<body>
    <h3>Create a new Goods</h3>
     <form method="POST" action="/goods" >
        <div class="mb-3">
        
        <input name="goods[name]" placeholder="enter goods name" type="text" class="form-control"required/>
       </div>
        <div class="mb-3">
            
        <input name="goods[category]" placeholder="enter  category" type="text" class="form-control"required />
        </div>
        
        <div class="mb-3">
            
        <input name="goods[brand]" placeholder="enter  brand" type="text" class="form-control"required />
       </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
        <textarea name="goods[description]" placeholder="enter  description" class="form-control" required></textarea>
       </div>
        
       <div class="row">
       <div class="mb-3 col-6">
    
        <input name="goods[price]" placeholder="enter goods price" class="form-control" required/>
        <div class="invalid-feedback">Please enter the Valid Price</div>
    </div>

    <div class="mb-3 col-6">
        
        <input name="goods[stock]" placeholder="enter stock available" class="form-control" required/>
    </div>
</div>
      <div class="mb-3">
        <input name="goods[image]" type="file" class="form-control" />    
    </div> 
       <br/> <br/>
        <button class="btn btn-dark">Add new Product</button>
        <br/>
        <br/>
    </form>

</body>